<Window x:Class="ObsVoiceAssistant.Configuration.ObsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка OBS"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Адрес OBS WebSocket" />
                <TextBox x:Name="UrlTextBox" Margin="0,6,0,14" />

                <TextBlock Text="Пароль WebSocket (необязательно)" />
                <PasswordBox x:Name="PasswordBox" Margin="0,6,0,14" Height="24" />

                <TextBlock Text="Источники OBS для звуковых команд"
                           FontWeight="Bold"
                           Margin="0,6,0,4" />
                <TextBlock Text="Имя должно совпадать с именем источника в OBS. Нажмите «Загрузить из OBS», чтобы взять список из запущенного OBS. Пункт «не использовать» отключает роль. Один и тот же источник можно выбрать в нескольких полях."
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,0,0,10" />

                <Button x:Name="LoadInputsButton"
                        Content="Загрузить из OBS"
                        Width="170"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Click="LoadInputs_Click" />

                <TextBlock Text="Микрофон" />
                <ComboBox x:Name="MicrophoneBox" IsEditable="True" Margin="0,6,0,10" />

                <TextBlock Text="Браузер" />
                <ComboBox x:Name="BrowserBox" IsEditable="True" Margin="0,6,0,10" />

                <TextBlock Text="Музыка стрима" />
                <ComboBox x:Name="StreamMusicBox" IsEditable="True" Margin="0,6,0,10" />

                <TextBlock Text="Личная музыка" />
                <ComboBox x:Name="PersonalMusicBox" IsEditable="True" Margin="0,6,0,10" />

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#B00020" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Width="95" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Отмена" Width="95" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
