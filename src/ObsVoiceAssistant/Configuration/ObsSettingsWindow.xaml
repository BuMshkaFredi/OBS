<Window x:Class="ObsVoiceAssistant.Configuration.ObsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="540"
        Height="760"
        MinWidth="520"
        MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Адрес OBS WebSocket" />
                <TextBox x:Name="UrlTextBox" Margin="0,6,0,14" />

                <TextBlock Text="Пароль WebSocket (необязательно)" />
                <PasswordBox x:Name="PasswordBox" Margin="0,6,0,14" Height="24" />

                <TextBlock Text="Клавиша Push-to-talk"
                           FontWeight="Bold"
                           Margin="0,6,0,4" />
                <TextBlock Text="Удерживайте клавишу или комбинацию во время речи. Пустое поле — Caps Lock, его обычное переключение не выполняется. Примеры: F9, Ctrl+Shift+F9, Alt+Z. Кнопка «Определить» записывает то, что реально нажала вторая клавиатура или макро-клавиша."
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PushToTalkHotkeyBox"
                             Grid.Column="0"
                             Width="170"
                             Margin="0,6,8,14" />
                    <Button x:Name="CaptureHotkeyButton"
                            Grid.Column="1"
                            Content="Определить"
                            Width="100"
                            Margin="0,6,0,14"
                            Click="CaptureHotkey_Click" />
                </Grid>

                <TextBlock Text="Источники OBS для звуковых команд"
                           FontWeight="Bold"
                           Margin="0,6,0,4" />
                <TextBlock Text="Имя должно совпадать с именем источника в OBS. Нажмите «Загрузить из OBS», чтобы взять список из запущенного OBS. Пункт «не использовать» отключает роль. Один и тот же источник можно выбрать в нескольких полях."
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,0,0,10" />

                <Button x:Name="LoadInputsButton"
                        Content="Загрузить из OBS"
                        Width="170"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Click="LoadInputs_Click" />

                <TextBlock Text="Микрофон" />
                <ComboBox x:Name="MicrophoneBox" IsEditable="True" Margin="0,6,0,10" />

                <TextBlock Text="Браузер" />
                <ComboBox x:Name="BrowserBox" IsEditable="True" Margin="0,6,0,10" />

                <TextBlock Text="Музыка стрима" />
                <ComboBox x:Name="StreamMusicBox" IsEditable="True" Margin="0,6,0,10" />

                <TextBlock Text="Личная музыка" />
                <ComboBox x:Name="PersonalMusicBox" IsEditable="True" Margin="0,6,0,10" />

                <Separator Margin="0,10,0,12" />

                <TextBlock Text="Запись и повтор"
                           FontWeight="Bold"
                           FontSize="15" />
                <CheckBox x:Name="CreateMp4CopyCheckBox"
                          Content="Создавать MP4-копию записи и повтора"
                          Margin="0,8,0,4" />
                <TextBlock Text="Копия делается без перекодирования: качество не меняется. Нужен ffmpeg.exe — укажите путь или положите ffmpeg.exe в папку ffmpeg рядом с программой. Повтор OBS сохраняет сразу в MP4, для него копия не создаётся."
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,0,0,8" />
                <TextBlock Text="Путь к ffmpeg.exe" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FfmpegPathBox"
                             Grid.Column="0"
                             Margin="0,6,8,14" />
                    <Button x:Name="BrowseFfmpegButton"
                            Grid.Column="1"
                            Content="Обзор..."
                            Width="90"
                            Margin="0,6,0,14"
                            Click="BrowseFfmpeg_Click" />
                </Grid>

                <Separator Margin="0,10,0,12" />

                <TextBlock Text="Twitch"
                           FontWeight="Bold"
                           FontSize="15" />
                <TextBlock Text="Создайте приложение на dev.twitch.tv/console/apps и скопируйте Client ID. Client secret не нужен: используется вход через код устройства."
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,4,0,10" />

                <TextBlock Text="Client ID" />
                <TextBox x:Name="TwitchClientIdBox"
                         Margin="0,6,0,10"
                         TextChanged="TwitchClientId_TextChanged" />

                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="ConnectTwitchButton"
                            Content="Подключить Twitch"
                            Width="150"
                            Click="ConnectTwitch_Click" />
                    <Button x:Name="DisconnectTwitchButton"
                            Content="Отключить"
                            Width="95"
                            Margin="8,0,0,0"
                            Click="DisconnectTwitch_Click" />
                    <Button x:Name="OpenTwitchButton"
                            Content="Открыть страницу Twitch"
                            Width="170"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="OpenTwitch_Click" />
                </WrapPanel>

                <TextBlock x:Name="TwitchCodeText"
                           FontFamily="Consolas"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,4,0,4"
                           Visibility="Collapsed" />
                <TextBlock x:Name="TwitchStatusText"
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,4,0,12" />

                <Separator Margin="0,10,0,12" />

                <TextBlock Text="Оверлей зрителей"
                           FontWeight="Bold"
                           FontSize="15" />
                <CheckBox x:Name="ViewerOverlayCheckBox"
                          Content="Показывать счётчик зрителей"
                          Margin="0,8,0,4" />
                <TextBlock Text="Окно поверх всех окон не забирает фокус и скрывается, когда трансляция не идёт. Включить и скрыть окно можно также из меню в трее. Для показа в OBS добавьте захват этого окна или экрана."
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,0,0,8" />
                <TextBlock Text="Интервал обновления, секунд (не меньше 15)" />
                <TextBox x:Name="ViewerOverlayIntervalBox"
                         Width="80"
                         HorizontalAlignment="Left"
                         Margin="0,6,0,14" />

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#B00020" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Сохранить" Width="95" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Отмена" Width="95" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
